{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gauntlet.invalid/schemas/v1/workload-version.schema.json",
  "title": "WorkloadVersion",
  "description": "Immutable versioned fingerprint of a harness, model, tool set, and execution environment (spec 18.1). One denominator unit for experiments and assurance claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "api_version",
    "id",
    "tenant_id",
    "name",
    "version",
    "fingerprint",
    "harness",
    "model",
    "tools",
    "environment",
    "supported_modes",
    "created_at"
  ],
  "properties": {
    "kind": { "const": "WorkloadVersion" },
    "api_version": { "$ref": "common.schema.json#/$defs/apiVersion" },
    "id": { "$ref": "common.schema.json#/$defs/idWorkloadVersion" },
    "tenant_id": { "$ref": "common.schema.json#/$defs/tenantId" },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$",
      "description": "Stable workload name. The (name, version) pair identifies this resource."
    },
    "version": { "$ref": "common.schema.json#/$defs/semVer" },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "fingerprint": {
      "$ref": "common.schema.json#/$defs/digest",
      "description": "Digest over the canonical harness, model, tools, and environment identity (spec 9.2, 14.7). Claim freshness binds to this value."
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "version": { "$ref": "common.schema.json#/$defs/semVer" },
        "digest": { "$ref": "common.schema.json#/$defs/digest" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model_id"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
        "model_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Provider-side model version or snapshot identifier, when published."
        },
        "config_digest": {
          "$ref": "common.schema.json#/$defs/digest",
          "description": "Digest of the decoding and sampling configuration."
        }
      }
    },
    "tools": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "version": { "$ref": "common.schema.json#/$defs/semVer" },
          "digest": { "$ref": "common.schema.json#/$defs/digest" },
          "adapter": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "description": "Adapter identity that mediates this tool, when the tool crosses the external boundary."
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend"],
      "properties": {
        "backend": { "$ref": "common.schema.json#/$defs/sandboxBackend" },
        "image_digest": { "$ref": "common.schema.json#/$defs/digest" },
        "topology_digest": {
          "$ref": "common.schema.json#/$defs/digest",
          "description": "Digest of the network and service topology definition."
        }
      }
    },
    "supported_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/operatingMode" },
      "description": "Modes this workload version may run in. The compiler rejects mode mismatches (spec 9.1)."
    },
    "created_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" }
  }
}
