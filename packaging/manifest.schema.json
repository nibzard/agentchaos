{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenCoreManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "api_version",
    "name",
    "version",
    "license",
    "name_note",
    "components",
    "supporting",
    "excluded"
  ],
  "properties": {
    "kind": {"const": "OpenCoreManifest"},
    "api_version": {"const": "v1"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,31}$"},
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "license": {"const": "Apache-2.0"},
    "name_note": {"type": "string", "minLength": 1},
    "components": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "promise", "spec_ref", "paths"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,63}$"
          },
          "promise": {"type": "string", "minLength": 1},
          "spec_ref": {"type": "string", "minLength": 1},
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9/._-]*$"}
          }
        }
      }
    },
    "supporting": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paths", "reason"],
        "properties": {
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9/._-]*$"}
          },
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "excluded": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9/._-]*$"
          },
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
